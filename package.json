{
  "name": "loyalty-program",
  "private": true,
  "scripts": {
    "dev:backend":  "npm run dev --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "dev:all":      "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:infra":    "docker compose up postgres redis -d",
    "build:backend":  "npm run build --prefix Backend",
    "build:frontend": "npm run build --prefix Frontend",
    "lint":         "npm run lint:backend && npm run lint:frontend",
    "lint:backend":  "npm run lint --prefix Backend",
    "lint:frontend": "npm run lint --prefix Frontend",
    "typecheck":    "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend":  "npm run typecheck --prefix Backend",
    "typecheck:frontend": "npm run typecheck --prefix Frontend",
    "test:backend":  "npm run test:unit --prefix Backend",
    "test:frontend": "npm run test:unit --prefix Frontend",
    "db:generate":   "npm run prisma:generate --prefix Backend",
    "db:migrate":    "npm run prisma:migrate --prefix Backend",
    "db:seed":       "npm run prisma:seed --prefix Backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}