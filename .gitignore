.env.*.local
.env*.backup
.env*.prod
.env*.dev
.env*.test
.env*.staging
.pem
*.key
*.pub
*.p12
*.pfx
*.jks
credentials.json
secrets.yaml
secrets.yml
*.gpg
.ssh/
.aws/
.azure/
~/.kube/config

# ============================================================================
