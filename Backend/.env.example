# Backend environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (GCP Cloud SQL — PostgreSQL) ──────────────────────────────────
# Local dev: direct connection
DATABASE_URL=postgresql://loyalty_user:loyalty_pass@loyalty-postgres:5432/loyalty_db

# ── Auth ───────────────────────────────────────────────────────────────────
# Must match NEXTAUTH_SECRET in Frontend
NEXTAUTH_SECRET=your-super-secret-32-char-string-here

# ── Frontend origin (for CORS) ─────────────────────────────────────────────
FRONTEND_ORIGIN=https://loyaltyprogramberijalan.34.101.180.46.nip.io

# ── Redis Cache (Memurai local, Redis production) ──────────────────────────
REDIS_ENABLED=true
REDIS_HOST=loyalty-redis
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here
REDIS_USE_TLS=false
REDIS_CONNECTION_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_KEY_PREFIX=loyalty:dev
REDIS_DEFAULT_TTL=300

# ── GCP Cloud SQL (production) ─────────────────────────────────────────────
# Use Cloud SQL Auth Proxy socket in production:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost/loyalty_db?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME"
