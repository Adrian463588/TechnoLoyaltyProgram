generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──
enum UserRole {
  MITRA
  TEAM_LEADER
  HC_PM
}

enum DivisionType {
  OPCENT
  TELE
  TECHNO
}

enum PartnershipStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

enum MemberTierType {
  SAPHIRE
  EMERALD
  RUBY
  DIAMOND
}

enum HealthBenefit {
  NONE
  FIT
  CLASSY
}

enum TokenEventType {
  EARNED_SHIFT
  EARNED_PROJECT
  REDEEMED
  EXPIRED
  MANUAL_ADJUSTMENT
  DOWNGRADE_PENALTY
  RESET_PENALTY
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadStatus {
  STAGED
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
}

enum RedemptionStatus {
  REQUESTED
  REVIEWED
  ACCEPTED
  REJECTED
  CANCELLED
}

// ── Identity & Access ──
model User {
  id             String            @id @default(uuid())
  email          String            @unique
  npk            String            @unique
  name           String
  passwordHash   String
  division       DivisionType
  role           UserRole          @default(MITRA)
  partnerStatus  PartnershipStatus @default(ACTIVE)
  membershipTier MemberTierType    @default(SAPHIRE)
  healthBenefit  HealthBenefit     @default(NONE)
  teamLeadId     String?
  joinedAt       DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  teamLead                        User?                       @relation("TeamHierarchy", fields: [teamLeadId], references: [id])
  subordinates                    User[]                      @relation("TeamHierarchy")
  tokenLedger                     TokenLedger[]
  membershipHistory               MembershipHistory[]
  shiftClaims                     ShiftClaim[]
  projectClaims                   ProjectClaim[]
  redemptions                     RedemptionRequest[]
  documents                       UserDocument[]
  // Partner Status Confirmation back-relations
  partnerConfirmationsAsSubject   PartnerStatusConfirmation[] @relation("PartnerConfirmationSubject")
  partnerConfirmationsAsRequester PartnerStatusConfirmation[] @relation("PartnerConfirmationRequester")
  partnerConfirmationsAsAssignee  PartnerStatusConfirmation[] @relation("PartnerConfirmationAssignee")
}

// ── Token Ledger (append-only) ──
model TokenLedger {
  id           String         @id @default(uuid())
  userId       String
  eventType    TokenEventType
  amount       Int // +/-
  balanceAfter Int // snapshot
  referenceId  String? // FK to shift/project/redemption
  earnedYear   Int? // for expiry
  expiresAt    DateTime? // Dec 31 of (earnedYear + 3)
  reason       String? // required for MANUAL_ADJUSTMENT, penalties
  performedBy  String // actor ID
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, eventType])
}

// ── Membership History (append-only) ──
model MembershipHistory {
  id                 String         @id @default(uuid())
  userId             String
  previousTier       MemberTierType
  newTier            MemberTierType
  changeReason       String // UPGRADE, DOWNGRADE, RESET, MANUAL
  triggeredBy        String // actor ID
  tokenBalanceBefore Int
  tokenBalanceAfter  Int
  createdAt          DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

// ── Claims ──
model ShiftClaim {
  id              String      @id @default(uuid())
  mitraId         String
  slotCount       Int
  shiftDate       DateTime
  status          ClaimStatus @default(PENDING)
  validatedBy     String? // actor ID
  validatedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())

  mitra User @relation(fields: [mitraId], references: [id])
}

model ProjectClaim {
  id              String      @id @default(uuid())
  mitraId         String
  projectName     String
  completedAt     DateTime
  status          ClaimStatus @default(PENDING)
  validatedBy     String? // actor ID
  validatedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())

  mitra User @relation(fields: [mitraId], references: [id])
}

// ── Rewards & Redemptions ──
model RewardItem {
  id          String         @id @default(uuid())
  name        String
  description String?
  tokenCost   Int
  imageUrl    String?
  category    String? // optional eligibility category
  minTier     MemberTierType @default(SAPHIRE)
  isActive    Boolean        @default(true)
  stock       Int? // null = unlimited
  createdBy   String // actor ID
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  redemptions RedemptionRequest[]
}

model RedemptionRequest {
  id                      String           @id @default(uuid())
  mitraId                 String
  rewardItemId            String
  tokenCost               Int // snapshot
  status                  RedemptionStatus @default(REQUESTED)
  submittedAt             DateTime         @default(now())
  verifiedBy              String? // actor ID
  verifiedAt              DateTime?
  rejectionReason         String?
  pickupScheduledAt       DateTime?
  completedAt             DateTime?
  // Document verification
  idCardVerified          Boolean          @default(false)
  ktpVerified             Boolean          @default(false)
  npwpVerified            Boolean          @default(false)
  isRepresented           Boolean          @default(false)
  powerOfAttorneyUrl      String? // relative path to uploaded file
  powerOfAttorneyRequired Boolean          @default(false)
  powerOfAttorneyVerified Boolean?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  mitra                User                        @relation(fields: [mitraId], references: [id])
  rewardItem           RewardItem                  @relation(fields: [rewardItemId], references: [id])
  history              RedemptionStatusHistory[]
  partnerConfirmations PartnerStatusConfirmation[]
}

model RedemptionStatusHistory {
  id                  String           @id @default(uuid())
  redemptionRequestId String
  previousStatus      RedemptionStatus
  newStatus           RedemptionStatus
  changedBy           String // actor ID
  note                String?
  createdAt           DateTime         @default(now())

  request RedemptionRequest @relation(fields: [redemptionRequestId], references: [id])
}

// ── Audit ──
model AuditLog {
  id               String   @id @default(uuid())
  actorId          String
  action           String // e.g. 'TOKEN_MANUAL_ADJUST'
  targetUserId     String?
  targetEntityType String?
  targetEntityId   String?
  previousValue    Json?
  newValue         Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
}

// ── Scheduled Job Idempotency Guard ──
// PRD §5.3 / AGENTS.md §8
model JobRun {
  id         String    @id @default(uuid())
  jobName    String // stable key e.g. 'token-expiry', 'membership-evaluation'
  periodKey  String // e.g. '2026-05', '2026-P1'
  status     String    @default("RUNNING") // RUNNING | SUCCESS | FAILED | SKIPPED
  summary    Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([jobName, periodKey])
  @@index([jobName, periodKey])
}

// ── Partner Status Confirmation ──
// PRD HC-06 / TL-01: HC asks TL to confirm active/resigned status
model PartnerStatusConfirmation {
  id                  String    @id @default(uuid())
  redemptionRequestId String
  mitraId             String
  requestedBy         String // HC actor ID
  assignedTo          String // TL/Lead actor ID
  status              String    @default("PENDING") // PENDING | CONFIRMED_ACTIVE | CONFIRMED_RESIGNED | CANCELLED
  note                String?
  confirmedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  redemptionRequest RedemptionRequest @relation(fields: [redemptionRequestId], references: [id])
  mitra             User              @relation("PartnerConfirmationSubject", fields: [mitraId], references: [id])
  requester         User              @relation("PartnerConfirmationRequester", fields: [requestedBy], references: [id])
  assignee          User              @relation("PartnerConfirmationAssignee", fields: [assignedTo], references: [id])

  @@index([redemptionRequestId])
  @@index([assignedTo, status])
}

// ── User Documents ──
model UserDocument {
  id        String   @id @default(uuid())
  userId    String
  type      String // "ID_CARD_MITRA", "KTP", "NPWP"
  fileUrl   String // relative path
  fileName  String // original filename
  fileSize  Int // bytes
  mimeType  String // image/png, etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

// ── Global System Settings ──
// Stores recurring configurations like P1/P2 dates, redemption windows, and pickup locations.
// Dates are stored as "MM-DD" string to repeat annually.
model SystemSetting {
  id                  String   @id @default("GLOBAL_CONFIG")
  p1Start             String   @default("06-16")
  p1End               String   @default("12-15")
  p2Start             String   @default("12-16")
  p2End               String   @default("06-15")
  claimP1Start        String   @default("01-01")
  claimP1End          String   @default("01-31")
  claimP2Start        String   @default("07-01")
  claimP2End          String   @default("07-31")
  rewardPickupLocation String   @default("HC Office - Main Building")
  updatedBy           String?
  updatedAt           DateTime @updatedAt
}
