generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──
enum RoleType {
  MITRA
  TEAM_LEADER
  HC_PM
}

enum DivisionType {
  OPTEL
  TECHNO
}

enum PartnershipStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
  TERMINATED
}

enum MemberTierType {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum UploadStatus {
  STAGED
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
}

enum RedemptionStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  PURCHASED
  PICKUP_SCHEDULED
  COMPLETED
  CANCELLED
}

// ── Identity & Access ──
model User {
  id           String   @id @default(uuid())
  npk          String   @unique
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true) // Required by auth
  role         RoleType @default(MITRA)
  divisionId   String?
  teamId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  division          Division?                 @relation(fields: [divisionId], references: [id])
  team              Team?                     @relation(fields: [teamId], references: [id])
  loyaltyProfile    UserLoyaltyProfile?
  employmentHistory EmploymentStatusHistory[]
  redemptions       RewardRedemptionRequest[]
}

model Division {
  id        String       @id @default(uuid())
  name      String       @unique
  type      DivisionType
  createdAt DateTime     @default(now())

  users User[]
  teams Team[]
}

model Team {
  id         String   @id @default(uuid())
  name       String
  leaderId   String?
  divisionId String
  createdAt  DateTime @default(now())

  division Division @relation(fields: [divisionId], references: [id])
  users    User[]
}

// ── Historical Statuses ──
model EmploymentStatusHistory {
  id        String           @id @default(uuid())
  userId    String
  status    EmploymentStatus
  changedAt DateTime         @default(now())
  reason    String?
  actorId   String // SYSTEM or admin ID

  user User @relation(fields: [userId], references: [id])
}

// ── Loyalty Domain ──
model EarningPeriod {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "P1-2026"
  startDate DateTime
  endDate   DateTime // Cut-off
  isActive  Boolean  @default(false)

  ledgers TokenLedgerEntry[]
}

model UserLoyaltyProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  currentTier     MemberTierType @default(BRONZE)
  totalTokens     Int            @default(0)
  remainingTokens Int            @default(0)
  tokenAgeMonths  Int            @default(0)
  isEligible      Boolean        @default(false)
  commitmentDate  DateTime?
  lastResetAt     DateTime?
  updatedAt       DateTime       @updatedAt

  memberStatus    String         @default("ACTIVE") // ACTIVE | DOWNGRADED | RESET | INACTIVE

  user    User                 @relation(fields: [userId], references: [id])
  metrics UserDivisionMetric[]
}

model UserDivisionMetric {
  id                String       @id @default(uuid())
  profileId         String
  divisionType      DivisionType
  // Optel
  totalSlots        Int?
  regularSlots      Int?
  // Techno
  sprintBalance     Int?
  projectRejections Int?

  profile UserLoyaltyProfile @relation(fields: [profileId], references: [id])
}

model TokenLedgerEntry {
  id         String   @id @default(uuid())
  userId     String
  periodId   String
  amount     Int // +/-
  sourceType String // UPLOAD_OPTEL, UPLOAD_TECHNO, REDEMPTION
  sourceId   String? // upload row ID or redemption request ID
  createdAt  DateTime @default(now())

  period EarningPeriod @relation(fields: [periodId], references: [id])
}

// ── Upload Pipeline ──
model MonthlyUpload {
  id           String       @id @default(uuid())
  filename     String
  divisionType DivisionType
  status       UploadStatus @default(STAGED)
  uploadedById String
  createdAt    DateTime     @default(now())

  batches UploadBatch[]
}

model UploadBatch {
  id          String    @id @default(uuid())
  uploadId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  totalRows   Int       @default(0)
  errorRows   Int       @default(0)

  upload      MonthlyUpload      @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  stagingRows UploadRowStaging[]
}

model UploadRowStaging {
  id        String  @id @default(uuid())
  batchId   String
  rowNumber Int
  rawData   Json
  isValid   Boolean @default(false)

  batch  UploadBatch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  issues UploadValidationIssue[]
}

model UploadValidationIssue {
  id       String @id @default(uuid())
  rowId    String
  column   String
  issue    String
  severity String // ERROR | WARNING

  row UploadRowStaging @relation(fields: [rowId], references: [id], onDelete: Cascade)
}

// ── Redemptions ──
model RewardItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  tokenCost   Int
  stockLimit  Int?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests RewardRedemptionRequest[]
}

model RewardRedemptionRequest {
  id           String           @id @default(uuid())
  userId       String
  rewardItemId String
  tokensSpent  Int
  status       RedemptionStatus @default(DRAFT)
  pickupDate   DateTime?
  rejectReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user    User                            @relation(fields: [userId], references: [id])
  item    RewardItem                      @relation(fields: [rewardItemId], references: [id])
  history RewardRedemptionStatusHistory[]
}

model RewardRedemptionStatusHistory {
  id        String           @id @default(uuid())
  requestId String
  toStatus  RedemptionStatus
  actorId   String
  reason    String?
  createdAt DateTime         @default(now())

  request RewardRedemptionRequest @relation(fields: [requestId], references: [id])
}

// ── Audit ──
model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String
  targetType String
  targetId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}
