{
  "name": "loyalty-backend",
  "version": "1.0.0",
  "description": "Berijalan Employee Loyalty Program — Backend REST API",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev":              "ts-node-dev --respawn --transpile-only src/app.ts",
    "build":            "tsc --project tsconfig.json",
    "start":            "node dist/app.js",
    "lint":             "eslint \"src/**/*.ts\"",
    "lint:fix":         "eslint \"src/**/*.ts\" --fix",
    "typecheck":        "tsc --noEmit",
    "test:unit":        "vitest run",
    "test:unit:watch":  "vitest",
    "prisma:generate":  "prisma generate",
    "prisma:migrate":   "prisma migrate dev",
    "prisma:seed":      "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client":     "^7.8.0",
    "bcryptjs":           "^3.0.3",
    "cors":               "^2.8.5",
    "exceljs":            "^4.4.0",
    "express":            "^4.21.2",
    "papaparse":          "^5.5.3",
    "pg":                 "^8.20.0",
    "prisma":             "^7.8.0",
    "xlsx":               "^0.18.5",
    "zod":                "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs":    "^2.4.6",
    "@types/cors":        "^2.8.17",
    "@types/express":     "^4.17.21",
    "@types/node":        "^20",
    "@types/papaparse":   "^5.5.2",
    "@types/pg":          "^8.20.0",
    "eslint":             "^9",
    "jsdom":              "^29.1.1",
    "ts-node":            "^10.9.2",
    "ts-node-dev":        "^2.0.0",
    "typescript":         "^5",
    "typescript-eslint":  "^8",
    "vitest":             "^4.1.5"
  }
}
