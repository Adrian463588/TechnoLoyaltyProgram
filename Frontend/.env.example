# Frontend environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local to git.

# ── NextAuth ──────────────────────────────────────────────────────────────
# LOCAL: http://localhost:3000
# COOLIFY: Must be the EXACT FQDN generated by Traefik (e.g. http://m4nx9kc046wxksnhs6zfseor.34.128.73.127.sslip.io)
# CRITICAL: DO NOT use hardcoded IP:PORT in Coolify. It will bypass the reverse proxy and timeout.
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=your-super-secret-32-char-string-here

# ── Backend API URL ────────────────────────────────────────────────────────
# Server-side (used in server components and API routes)
# LOCAL: http://localhost:8081/api
# COOLIFY: Use the internal Docker network URL for speed (e.g. http://loyalty-backend:3000)
BACKEND_URL=http://localhost:8081/api

# Client-side (used in browser — only expose non-sensitive URLs)
# LOCAL: http://localhost:8081/api
# COOLIFY: Must be the EXACT Backend FQDN (e.g. http://mhv74q5gor8464d8v6nc69vn.34.128.73.127.sslip.io/api)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081/api

# ── AI Chatbot ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
CHATBOT_ENABLED=true
