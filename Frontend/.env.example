# Frontend environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local to git.

# ── NextAuth ──────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-32-char-string-here"

# ── Backend API URL ────────────────────────────────────────────────────────
# Server-side (used in server components and API routes)
BACKEND_URL="http://localhost:8080"

# Client-side (used in browser — only expose non-sensitive URLs)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8080"

# ── GCP Production ─────────────────────────────────────────────────────────
# NEXTAUTH_URL="https://loyalty-frontend-xxxx-as.a.run.app"
# BACKEND_URL="https://loyalty-backend-xxxx-as.a.run.app"
# NEXT_PUBLIC_BACKEND_URL="https://loyalty-backend-xxxx-as.a.run.app"
