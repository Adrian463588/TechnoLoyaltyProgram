{
  "compilerOptions": {
    "target":               "ES2017",
    "lib":                  ["dom", "dom.iterable", "esnext"],
    "allowJs":              true,
    "skipLibCheck":         true,
    "strict":               true,
    "noUncheckedIndexedAccess": true,
    "noEmit":               true,
    "esModuleInterop":      true,
    "module":               "esnext",
    "moduleResolution":     "bundler",
    "resolveJsonModule":    true,
    "isolatedModules":      true,
    "jsx":                  "react-jsx",
    "incremental":          true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*":             ["./src/*"],
      "@/components/*":  ["./src/components/*"],
      "@/features/*":    ["./src/features/*"],
      "@/hooks/*":       ["./src/hooks/*"],
      "@/lib/*":         ["./src/lib/*"],
      "@/styles/*":      ["./src/styles/*"],
      "@/types/*":       ["./src/types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
