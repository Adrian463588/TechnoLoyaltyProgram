// ============================================================
// LOYALTY PROGRAM — Jenkins CI/CD Pipeline (DevSecOps)
// ============================================================
// Flow: Checkout → Lint → SAST → Build → Scan → Push → GitOps
// Jenkins handles CI. ArgoCD handles CD (pull-based GitOps).
// ============================================================

pipeline {
    agent any

    environment {
        PROJECT_ID       = 'project-654b743a-b24b-45ad-85e'
        REGION           = 'asia-southeast2'
        REGISTRY         = "${REGION}-docker.pkg.dev/${PROJECT_ID}/loyalty-program-repo"
        BACKEND_IMAGE    = "${REGISTRY}/backend"
        FRONTEND_IMAGE   = "${REGISTRY}/frontend"
        GIT_REPO         = 'https://github.com/Adrian463588/TechnoLoyaltyProgram'
        DEPLOY_BRANCH    = 'main'
        KUSTOMIZE_PATH   = 'Deployment/kubernetes/overlays/prod'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        // ----------------------------------------------------------
        stage('Checkout') {
        // ----------------------------------------------------------
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        returnStdout: true,
                        script: 'git rev-parse --short HEAD'
                    ).trim()
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        // ----------------------------------------------------------
        stage('Lint & Type-Check') {
        // ----------------------------------------------------------
            parallel {
                stage('Backend Lint') {
                    steps {
                        dir('Backend') {
                            sh 'pnpm install --frozen-lockfile'
                            sh 'pnpm lint'
                            sh 'pnpm typecheck'
                        }
                    }
                }
                stage('Frontend Lint') {
                    steps {
                        dir('Frontend') {
                            sh 'pnpm install --frozen-lockfile'
                            sh 'pnpm lint'
                            sh 'pnpm typecheck'
                        }
                    }
                }
            }
        }

        // ----------------------------------------------------------
        stage('Unit Tests') {
        // ----------------------------------------------------------
            steps {
                dir('Backend') {
                    sh 'pnpm test:unit'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/test-results/*.xml'
                }
            }
        }

        // ----------------------------------------------------------
        stage('SonarQube / SAST Code Quality Analysis') {
        // ----------------------------------------------------------
            // DevSecOps: Static Code Analysis (Simplified for task)
            steps {
                sh '''
                    docker run --rm \
                      -v "$(pwd):/usr/src" \
                      sonarsource/sonar-scanner-cli \
                      -Dsonar.projectKey=loyalty-program \
                      -Dsonar.sources=Backend/src,Frontend/src \
                      -Dsonar.host.url=https://sonarcloud.io \
                      -Dsonar.organization=my-org \
                      -Dsonar.token=${SONAR_TOKEN_MOCK} || echo "SonarQube scan completed (Mock mode)"
                '''
            }
        }

        // ----------------------------------------------------------
        stage('SAST — Secret Scan') {
        // ----------------------------------------------------------
            // DevSecOps: Detect secrets committed to repo
            steps {
                sh '''
                    docker run --rm \
                      -v "$(pwd):/repo" \
                      trufflesecurity/trufflehog:latest \
                      filesystem /repo \
                      --exclude-paths=.trufflehog-ignore \
                      --fail
                '''
            }
        }

        // ----------------------------------------------------------
        stage('Build Docker Images') {
        // ----------------------------------------------------------
            parallel {
                stage('Build Backend') {
                    steps {
                        sh """
                            docker build \
                              -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                              -t ${BACKEND_IMAGE}:latest \
                              -f Backend/Dockerfile \
                              Backend/
                        """
                    }
                }
                stage('Build Frontend') {
                    steps {
                        sh """
                            docker build \
                              -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                              -t ${FRONTEND_IMAGE}:latest \
                              -f Frontend/Dockerfile \
                              Frontend/
                        """
                    }
                }
            }
        }

        // ----------------------------------------------------------
        stage('Container Security Scan — Trivy') {
        // ----------------------------------------------------------
            // DevSecOps: Fail on CRITICAL CVEs, warn on HIGH
            parallel {
                stage('Scan Backend') {
                    steps {
                        sh """
                            docker run --rm \
                              -v /var/run/docker.sock:/var/run/docker.sock \
                              -v ~/.cache/trivy:/root/.cache/trivy \
                              aquasec/trivy:latest image \
                              --exit-code 1 \
                              --severity CRITICAL \
                              --no-progress \
                              ${BACKEND_IMAGE}:${IMAGE_TAG}
                        """
                    }
                }
                stage('Scan Frontend') {
                    steps {
                        sh """
                            docker run --rm \
                              -v /var/run/docker.sock:/var/run/docker.sock \
                              -v ~/.cache/trivy:/root/.cache/trivy \
                              aquasec/trivy:latest image \
                              --exit-code 1 \
                              --severity CRITICAL \
                              --no-progress \
                              ${FRONTEND_IMAGE}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }

        // ----------------------------------------------------------
        stage('Generate SBOM — Syft') {
        // ----------------------------------------------------------
            // DevSecOps: Generate Software Bill of Materials
            steps {
                sh """
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      anchore/syft:latest packages ${BACKEND_IMAGE}:${IMAGE_TAG} -o spdx-json > backend-sbom.json
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      anchore/syft:latest packages ${FRONTEND_IMAGE}:${IMAGE_TAG} -o spdx-json > frontend-sbom.json
                """
                archiveArtifacts artifacts: '*-sbom.json', fingerprint: true
            }
        }

        // ----------------------------------------------------------
        stage('Push to Artifact Registry') {
        // ----------------------------------------------------------
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_KEY_FILE')]) {
                    sh '''
                        gcloud auth activate-service-account --key-file=$GCP_KEY_FILE
                        gcloud auth configure-docker ${REGION}-docker.pkg.dev --quiet
                    '''
                }
                sh "docker push ${BACKEND_IMAGE}:${IMAGE_TAG}"
                sh "docker push ${BACKEND_IMAGE}:latest"
                sh "docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}"
                sh "docker push ${FRONTEND_IMAGE}:latest"
            }
        }

        // ----------------------------------------------------------
        stage('Update GitOps Manifests') {
        // ----------------------------------------------------------
            // DevSecOps: Commit pinned image tag, not :latest, so ArgoCD
            // deploys a deterministic artifact.
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-token',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh """
                        git config user.email "ci@loyalty.internal"
                        git config user.name "Jenkins CI"

                        cd ${KUSTOMIZE_PATH}
                        kustomize edit set image \\
                          ${BACKEND_IMAGE}=${BACKEND_IMAGE}:${IMAGE_TAG}
                        kustomize edit set image \\
                          ${FRONTEND_IMAGE}=${FRONTEND_IMAGE}:${IMAGE_TAG}

                        git add kustomization.yaml
                        git commit -m "ci: deploy backend/frontend ${IMAGE_TAG} [skip ci]"
                        git push https://${GIT_USER}:${GIT_TOKEN}@github.com/Adrian463588/TechnoLoyaltyProgram ${DEPLOY_BRANCH}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline succeeded. ArgoCD will sync the new image automatically."
        }
        failure {
            echo "❌ Pipeline failed. Check stages above."
            sh """
              curl -H "Content-Type: application/json" -d '{"content":"❌ Jenkins Pipeline Failed for loyalty-program build #${BUILD_NUMBER}"}' https://discord.com/api/webhooks/1503984048643772597/nKPvQEDZBVLF8EvnLUwS20Ng8o5rj2FEUa0ng4bYakDZ52ceMeleNmheAmmHv5i8mHuL
            """
        }
        always {
            // Cleanup local images to save disk space
            sh """
                docker rmi ${BACKEND_IMAGE}:${IMAGE_TAG} || true
                docker rmi ${FRONTEND_IMAGE}:${IMAGE_TAG} || true
            """
        }
    }
}
