// ============================================================
// LOYALTY PROGRAM — Jenkins CI/CD Pipeline (DevSecOps)
// ============================================================
// Flow: Checkout → Lint → SAST → Build → Scan → SBOM → Push → Sign → Coolify
// Jenkins handles CI and triggers Coolify application deploys.
// ArgoCD manages K3s DevOps tooling only.
// ============================================================

pipeline {
    agent any

    environment {
        PROJECT_ID       = 'project-654b743a-b24b-45ad-85e'
        REGION           = 'asia-southeast2'
        REGISTRY         = "${REGION}-docker.pkg.dev/${PROJECT_ID}/loyalty-program-repo"
        BACKEND_IMAGE    = "${REGISTRY}/backend"
        FRONTEND_IMAGE   = "${REGISTRY}/frontend"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        // ----------------------------------------------------------
        stage('Checkout') {
        // ----------------------------------------------------------
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        returnStdout: true,
                        script: 'git rev-parse --short HEAD'
                    ).trim()
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        // ----------------------------------------------------------
        stage('Lint & Type-Check') {
        // ----------------------------------------------------------
            parallel {
                stage('Backend Lint') {
                    steps {
                        dir('Backend') {
                            sh 'pnpm install --frozen-lockfile'
                            sh 'pnpm lint'
                            sh 'pnpm typecheck'
                        }
                    }
                }
                stage('Frontend Lint') {
                    steps {
                        dir('Frontend') {
                            sh 'pnpm install --frozen-lockfile'
                            sh 'pnpm lint'
                            sh 'pnpm typecheck'
                        }
                    }
                }
            }
        }

        // ----------------------------------------------------------
        stage('Unit Tests') {
        // ----------------------------------------------------------
            steps {
                dir('Backend') {
                    sh 'pnpm test:unit'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/test-results/*.xml'
                }
            }
        }

        // ----------------------------------------------------------
        stage('SonarQube / SAST Code Quality Analysis') {
        // ----------------------------------------------------------
            // DevSecOps: Static Code Analysis (Simplified for task)
            steps {
                sh '''
                    docker run --rm \
                      -v "$(pwd):/usr/src" \
                      sonarsource/sonar-scanner-cli \
                      -Dsonar.projectKey=loyalty-program \
                      -Dsonar.sources=Backend/src,Frontend/src \
                      -Dsonar.host.url=https://sonarcloud.io \
                      -Dsonar.organization=my-org \
                      -Dsonar.token=${SONAR_TOKEN_MOCK} || echo "SonarQube scan completed (Mock mode)"
                '''
            }
        }

        // ----------------------------------------------------------
        stage('SAST — Secret Scan') {
        // ----------------------------------------------------------
            // DevSecOps: Detect secrets committed to repo
            steps {
                sh '''
                    docker run --rm \
                      -v "$(pwd):/repo" \
                      trufflesecurity/trufflehog:3.88.25 \
                      filesystem /repo \
                      --exclude-paths=.trufflehog-ignore \
                      --fail
                '''
            }
        }

        // ----------------------------------------------------------
        stage('Build Docker Images') {
        // ----------------------------------------------------------
            parallel {
                stage('Build Backend') {
                    steps {
                        sh """
                            docker build \
                              -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                              -f Backend/Dockerfile \
                              Backend/
                        """
                    }
                }
                stage('Build Frontend') {
                    steps {
                        sh """
                            docker build \
                              -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                              -f Frontend/Dockerfile \
                              Frontend/
                        """
                    }
                }
            }
        }

        // ----------------------------------------------------------
        stage('Container Security Scan — Trivy') {
        // ----------------------------------------------------------
            // DevSecOps: Fail on CRITICAL CVEs, warn on HIGH
            parallel {
                stage('Scan Backend') {
                    steps {
                        sh """
                            docker run --rm \
                              -v /var/run/docker.sock:/var/run/docker.sock \
                              -v ~/.cache/trivy:/root/.cache/trivy \
                              aquasec/trivy:0.51.1 image \
                              --exit-code 1 \
                              --severity CRITICAL \
                              --no-progress \
                              ${BACKEND_IMAGE}:${IMAGE_TAG}
                        """
                    }
                }
                stage('Scan Frontend') {
                    steps {
                        sh """
                            docker run --rm \
                              -v /var/run/docker.sock:/var/run/docker.sock \
                              -v ~/.cache/trivy:/root/.cache/trivy \
                              aquasec/trivy:0.51.1 image \
                              --exit-code 1 \
                              --severity CRITICAL \
                              --no-progress \
                              ${FRONTEND_IMAGE}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }

        // ----------------------------------------------------------
        stage('Generate SBOM — Syft') {
        // ----------------------------------------------------------
            // DevSecOps: Generate Software Bill of Materials
            steps {
                sh """
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      anchore/syft:v1.4.1 packages ${BACKEND_IMAGE}:${IMAGE_TAG} -o spdx-json > backend-sbom.json
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      anchore/syft:v1.4.1 packages ${FRONTEND_IMAGE}:${IMAGE_TAG} -o spdx-json > frontend-sbom.json
                """
                archiveArtifacts artifacts: '*-sbom.json', fingerprint: true
            }
        }

        // ----------------------------------------------------------
        stage('Push to Artifact Registry') {
        // ----------------------------------------------------------
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_KEY_FILE')]) {
                    sh '''
                        gcloud auth activate-service-account --key-file=$GCP_KEY_FILE
                        gcloud auth configure-docker ${REGION}-docker.pkg.dev --quiet
                    '''
                }
                sh "docker push ${BACKEND_IMAGE}:${IMAGE_TAG}"
                sh "docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}"
            }
        }

        // ----------------------------------------------------------
        stage('Sign Images — Cosign') {
        // ----------------------------------------------------------
            steps {
                withCredentials([
                    file(credentialsId: 'cosign-key', variable: 'COSIGN_KEY'),
                    string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD')
                ]) {
                    sh '''
                        cosign sign --yes --key "$COSIGN_KEY" ${BACKEND_IMAGE}:${IMAGE_TAG}
                        cosign sign --yes --key "$COSIGN_KEY" ${FRONTEND_IMAGE}:${IMAGE_TAG}
                    '''
                }
            }
        }

        // ----------------------------------------------------------
        stage('Trigger Coolify Deploy') {
        // ----------------------------------------------------------
            // App runtime is Coolify. ArgoCD manages K3s DevOps tooling only.
            steps {
                withCredentials([
                    string(credentialsId: 'coolify-backend-webhook', variable: 'COOLIFY_BACKEND_WEBHOOK'),
                    string(credentialsId: 'coolify-frontend-webhook', variable: 'COOLIFY_FRONTEND_WEBHOOK')
                ]) {
                    sh '''
                        curl --fail --silent --show-error --request POST "$COOLIFY_BACKEND_WEBHOOK"
                        curl --fail --silent --show-error --request POST "$COOLIFY_FRONTEND_WEBHOOK"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded. Coolify deploy hooks were triggered."
        }
        failure {
            echo "Pipeline failed. Check stages above."
            withCredentials([string(credentialsId: 'discord-webhook-url', variable: 'DISCORD_WEBHOOK_URL')]) {
                sh '''
                  curl --fail --silent --show-error \
                    -H "Content-Type: application/json" \
                    -d "{\"content\":\"Jenkins Pipeline Failed for loyalty-program build #${BUILD_NUMBER}\"}" \
                    "$DISCORD_WEBHOOK_URL" || true
                '''
            }
        }
        always {
            // Cleanup local images to save disk space
            sh """
                docker rmi ${BACKEND_IMAGE}:${IMAGE_TAG} || true
                docker rmi ${FRONTEND_IMAGE}:${IMAGE_TAG} || true
            """
        }
    }
}
